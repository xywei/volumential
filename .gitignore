# Neutralize any user-global core.excludesFile so that a clone ignores exactly
# what is listed below and nothing else.
!*

# Python bytecode and build products
__pycache__/
*.pyc
*.pyo
*.so
build/
builds/
dist/
*.egg-info
MANIFEST
setuptools*egg
setuptools.pth
distribute*egg
distribute*tar.gz
src/

# Environments and tool caches
.venv*
.cache
.mypy_cache
.pytest_cache
.ruff_cache
.ipynb_checkpoints/

# Documentation build output
doc/build/

# Generated at install/run time
_git_rev.py

# Test and profiling output
.coverage
pytest.xml
prof/
a.out

# Experiment/mesh/plot artifacts
*.png
*.hdf5
*.vtu
*.vts
*.msh
*.meshmode
gmsh_tmp/

# Editor scratch files
.sw[po]
.*.sw[po]
*~
